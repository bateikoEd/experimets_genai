# Databricks Configuration
# This file contains environment-specific configuration for Databricks integration

# Environment Variables Template
# Copy this to .env and fill in your actual values

# Databricks Workspace Configuration
DATABRICKS_HOST=https://dbc-5fa3019d-0508.cloud.databricks.com
DATABRICKS_TOKEN=<your-databricks-token>
DATABRICKS_CLUSTER_ID=<your-cluster-id>

# Databricks Connect Settings
SPARK_REMOTE=sc://dbc-5fa3019d-0508.cloud.databricks.com:443/;token=<your-token>;x-databricks-cluster-id=<cluster-id>

# Optional: Databricks SQL Warehouse
DATABRICKS_SQL_WAREHOUSE_ID=<your-warehouse-id>

# File paths for Databricks operations
DATABRICKS_DATA_PATH=/FileStore/shared_uploads/house_prices/
DATABRICKS_MODEL_PATH=/FileStore/shared_uploads/models/
DATABRICKS_NOTEBOOK_PATH=/Users/<your-email>/house-price-ml/